{
  "schemaVersion": 4,
  "name": "GitPredictor",
  "projectUrl": "https://github.com/wht-github/GitPredictor",
  "gallery": "PSGallery",
  "galleryUri": "https://www.powershellgallery.com/packages/GitPredictor",
  "required": true,
  "minimumPowerShellVersion": "7.2",
  "installScript": "packages/Install-GitPredictor.ps1",
  "installRoot": "%USERPROFILE%/Documents/PowerShell/Modules/GitPredictor",
  "profileContract": {
    "promptFunction": "Get-GitSimplePrompt",
    "completion": "Register-ArgumentCompleter -Native for git and git.exe"
  }
}
